# PulseGuard Docker Ignore File
# Files and directories to exclude from Docker build context
# ----------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual Environment
venv/
env/
ENV/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover
tests/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.kiro/

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile
jenkins/

# Kubernetes
k8s/
*.yaml
*.yml

# Monitoring
monitoring/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Scripts
scripts/

# Environment files
.env
.env.*

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
temp/
